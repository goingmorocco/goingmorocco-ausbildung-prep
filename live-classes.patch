+    },
+
+    async loadSessions() {
+      const { data, error } = await sb.from('class_sessions').select('*').eq('group_id', this.current.id).order('starts_at', { ascending: false });
+      if (error) return this.fail(error, 'تعذّر تحميل الحصص');

+    fail(e, fallback) { console.error(e); this.say((e && e.message && /forbidden|not_enrolled/.test(e.message)) ? 'غير مسموح' : fallback); },
+
+    async loadGroups() {
+      const { data, error } = await sb.from('class_groups').select('*').order('created_at', { ascending: false });

# Copy this file to .env for local development, or set these as
# environment variables in your hosting platform's dashboard for a real
# deployment. Never commit an actual .env file (it's already in .gitignore).

# Signs and verifies login sessions. Required for real deployments -- if
# unset, the app falls back to a local-dev-only value that must not be
# used in production. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only needed if you run `npm run audio` to generate real listening-section
# audio (see README.md -> "توليد صوت حقيقي لأقسام الاستماع"). Not required
# for the app to run.
OPENAI_API_KEY=

# Most hosting platforms (Render, Railway, etc.) set this automatically --
# you usually don't need to set it yourself.
PORT=3000
